# ---- Claude API (console.anthropic.com → API Keys) ----
ANTHROPIC_API_KEY=sk-ant-...
# claude-haiku-5-5 = murah & laju (disyorkan) | claude-sonnet-5-5 = lebih bijak, lebih mahal
ANTHROPIC_MODEL=claude-haiku-5-5

# ---- ToyyibPay ----
# true = mod ujian (dev.toyyibpay.com), false = bayaran sebenar (toyyibpay.com)
TOYYIBPAY_SANDBOX=true
TOYYIBPAY_SECRET_KEY=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
TOYYIBPAY_CATEGORY_CODE=xxxxxxxx
