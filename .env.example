# Nama jenama anda (dipaparkan di website & bil ToyyibPay)
NEXT_PUBLIC_APP_NAME=CopyLaju

# Alamat penuh website anda (tanpa / di hujung)
# cth: https://copylaju.com  atau  https://copylaju.vercel.app
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ---- Supabase (Project Settings → API) ----
NEXT_PUBLIC_SUPABASE_URL=https://arbkezqmvmnflgscwpuq.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6ImFyYmtlenFtdm1uZmxnc2N3cHVxIiwicm9sZSI6ImFub24iLCJpYXQiOjE3OTUwNDM1ODksImV4cCI6MjExMDYxOTU4OX0.UUsF4eXy9ab6dNtHkQxoKWjtWd9Jfb3oDF1_PGWGyoY
# RAHSIA — salin sendiri dari Supabase → Project Settings → API Keys → Legacy → service_role. Jangan kongsi / jangan letak dalam kod frontend
